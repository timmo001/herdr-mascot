{
  "name": "herdr-mascot",
  "version": "0.1.0",
  "private": true,
  "description": "An animated mascot for the active Herdr pane",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun build src/index.ts --target=bun --external @resvg/resvg-js --outdir dist",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@herdr/sdk": "github:timmo001/herdr-ts-sdk#dd123bffd28150f70adcd984500a5c591dc6e7a3",
    "@resvg/resvg-js": "2.6.2",
    "effect": "4.0.0-rc.117",
    "proper-lockfile": "4.1.2",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@oxlint/plugins": "1.83.0",
    "@timmo001/oxlint-rules": "0.3.5",
    "@types/bun": "1.4.2",
    "@types/proper-lockfile": "4.1.4",
    "oxlint": "1.83.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  },
  "overrides": {
    "effect": "$effect",
    "@effect/platform-node-shared": "$@effect/platform-node"
  },
  "trustedDependencies": [
    "@effect/tsgo"
  ]
}
